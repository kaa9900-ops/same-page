    "defaultPrompt": [
      "\uc774 \uc5c5\ubb34\uc5d0 Same Page \uc808\ucc28\ub97c \uc801\uc6a9\ud574. \uba3c\uc800 \uc790\ub8cc\ub97c \uac80\ud1a0\ud558\uace0 \uc774\ud574\uac00 \ud544\uc694\ud55c \ub0b4\uc6a9\uc744 \uc9c8\ubb38\ud574.",
